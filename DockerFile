FROM mcr.microsoft.com/openjdk/jdk:21-ubuntu

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends bash ca-certificates curl unzip && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/maude.zip \
      https://github.com/maude-lang/Maude/releases/download/Maude3.5.1/Maude-3.5.1-linux-x86_64.zip && \
    unzip /tmp/maude.zip -d /opt/maude && \
    rm /tmp/maude.zip && \
    chmod +x /opt/maude/maude && \
    ln -s /opt/maude/maude /usr/local/bin/maude

COPY jar /app/jar
COPY maude /app/maude
COPY resources /app/resources
COPY scripts/run-test.sh /app/scripts/run-test.sh
COPY build/mta-dsl-overlay/maude-tls-attacker.jar /app/maude-tls-attacker.jar
COPY build/mta-dsl-overlay/tls-attacker-lib /app/tls-attacker-lib

RUN chmod +x /app/scripts/run-test.sh && \
    mkdir -p /work/generated /work/results /work/logs

# docker-build.py compiles maude-tls-attacker against the supplied local
# TLS-Attacker checkout and stages both local outputs under build/mta-dsl-overlay.
ENV MTA_CLASSPATH=/app/maude-tls-attacker.jar:/app/jar/*:/app/tls-attacker-lib/*
ENV MAUDE_LIB=/opt/maude

ENTRYPOINT ["/app/scripts/run-test.sh"]
