<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <File name="MAIN" fileName="${sys:logFilePath}" append="false" createOnDemand="true">
            <PatternLayout pattern="%d [%t] %p %c - %m%n"/>
        </File>
    </Appenders>

    <Loggers>
        <Logger name="de.rub.nds.tlsattacker.core.workflow.action.custom.AssertEqualAction"
                level="DEBUG"
                additivity="false">
            <AppenderRef ref="MAIN"/>
        </Logger>

        <Root level="WARN">
            <AppenderRef ref="MAIN"/>
        </Root>
    </Loggers>
</Configuration>
